# Copy to .env and fill in.

# Laptop webcam: 0 = built-in camera, 1/2... = external USB camera
CAMERA_INDEX=0

# Gemini cloud reader (assitant.py)
API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Local Qwen reader (smart_reader_qwen.py)
OLLAMA_HOST=http://localhost:11434
VLM_MODEL=qwen2.5vl:7b
# LM Studio instead of Ollama:
# VLM_BASE_URL=http://localhost:1234/v1

# Optional tuning
# YOLO_DEVICE=mps            # mps (Apple GPU) or cpu
# SPEECH_VOICE=Samantha      # list voices: say -v '?'
# SPEECH_RATE=180            # words per minute
