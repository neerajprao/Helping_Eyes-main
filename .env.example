# Copy to .env and fill in.

# IP of the ESP32-CAM or phone camera
PHONE_IP=192.168.x.x
# Full stream URL override (optional)
# CAMERA_URL=http://192.168.x.x:81/stream

# Gemini cloud reader (assitant.py)
API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Local Qwen reader (smart_reader_qwen.py)
OLLAMA_HOST=http://localhost:11434
VLM_MODEL=qwen2.5vl:7b
# LM Studio instead of Ollama:
# VLM_BASE_URL=http://localhost:1234/v1

# Optional tuning
# CAMERA_ROTATION=-90        # -90, 0, 90, 180
# YOLO_DEVICE=mps            # mps (Apple GPU) or cpu
# SPEECH_VOICE=Samantha      # list voices: say -v '?'
# SPEECH_RATE=180            # words per minute
