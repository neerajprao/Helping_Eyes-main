# Copy to .env and fill in.

# Camera: 0 = first camera macOS lists (a plugged-in USB camera usually comes first),
# 1 = the next one. Try the other number if the wrong camera opens.
CAMERA_INDEX=0

# Question answering (smart_reader.py): local model served by Ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct

# Gemini reader only (assitant.py)
API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional tuning
# TEXT_LANGUAGES=en-US,hi-IN  # languages to read; unset = auto-detect
# SPEECH_VOICE=Samantha       # list voices: say -v '?'
# SPEECH_RATE=180             # words per minute
