# Copy to .env (optional: every setting has a default).

# Language model, served by Ollama (https://ollama.com). The cloud image uses qwen2.5:3b-instruct.
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct

# OCR engine: apple (macOS default) or rapidocr (default everywhere else)
# OCR_ENGINE=rapidocr

# Optional tuning
# TEXT_LANGUAGES=en-US,hi-IN  # languages Apple Vision reads; unset = auto-detect
# VISION_ENHANCE=0            # turn off the image-correction layer
# BLUR_MIN=60                 # sharpness below this counts as blurry
