# Copy to .env. Only LLM_API_KEY is required.

# Language model: any chat API that speaks the OpenAI-style protocol.
# Default: Google Gemini Flash-Lite (free key from https://aistudio.google.com/apikey)
LLM_API_KEY=
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Other providers, same three settings, for example:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=<a Groq model name>
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1              LLM_MODEL=<a ":free" model name>

# Optional tuning of the image-correction layer
# VISION_ENHANCE=0            # turn it off
# BLUR_MIN=60                 # sharpness below this counts as blurry

# Spoken voice: a free Microsoft Edge neural voice (no key). The browser's own voice is the fallback.
# TTS_VOICE=en-US-JennyNeural   # female; also en-US-AriaNeural, en-US-AvaNeural, en-GB-SoniaNeural
# TTS_RATE=+0%                  # speaking speed, e.g. +10% or -10%
# TTS_ENABLED=0                 # 0 = always use the browser voice
