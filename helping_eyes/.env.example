# Copy to .env. Only LLM_API_KEY is required.

# Language model: any chat API that speaks the OpenAI-style protocol.
# Default: Google Gemini Flash-Lite (free key from https://aistudio.google.com/apikey)
LLM_API_KEY=
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Other providers, same three settings, for example:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=<a Groq model name>
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1              LLM_MODEL=<a ":free" model name>

# Optional tuning of the image-correction layer
# VISION_ENHANCE=0            # turn it off
# BLUR_MIN=60                 # sharpness below this counts as blurry

# Spoken voice. First choice: the local Kokoro voice (free, on this computer, no internet). Set it up once with
#   python run.py --get-voice
# If it is not set up or fails, the free Microsoft Edge voice speaks (no key), then the browser's own voice.
# TTS_ENGINE=kokoro             # kokoro (default) or edge
# KOKORO_VOICE=af_sarah         # American female; also af_heart, af_bella, af_nicole, am_michael (male), bf_emma (British)
# KOKORO_SPEED=1.0              # 1.0 is normal; 1.1 is a little faster
# TTS_VOICE=en-US-JennyNeural   # female; also en-US-AriaNeural, en-US-AvaNeural, en-GB-SoniaNeural
# TTS_RATE=+0%                  # speaking speed, e.g. +10% or -10%
# TTS_ENABLED=0                 # 0 = always use the browser voice

# A fixed public address for `python run.py --share` (free): sign up at https://dashboard.ngrok.com, claim your free
# domain under "Domains", run once:  ngrok config add-authtoken <your token>   then set it here, for example:
# NGROK_DOMAIN=your-name.ngrok-free.app
